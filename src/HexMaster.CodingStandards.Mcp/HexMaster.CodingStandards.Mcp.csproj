<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>0b2fde07-56ee-4b06-81f4-069d38cdb063</UserSecretsId>

    <!-- Hosted as a linux-x64 container image on Azure Container Apps: the base image
         supplies the runtime, so this publishes framework-dependent. Deliberately NOT
         self-contained or single-file - see the openspec design, "Container image instead
         of self-contained single-file publish". -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tool classes are internal, as nothing outside the host has any business
         constructing one. The host's own test project is the exception: the instruction text
         a tool returns is an interface, and it can only be asserted on from inside. -->
    <InternalsVisibleTo Include="HexMaster.CodingStandards.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexMaster.CodingStandards.Docs\HexMaster.CodingStandards.Docs.csproj" />
  </ItemGroup>

</Project>
