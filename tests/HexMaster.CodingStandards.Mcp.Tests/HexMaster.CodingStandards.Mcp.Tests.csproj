<Project Sdk="Microsoft.NET.Sdk">

  <!-- Covers what only the host can answer: the shape of a tool's response, and the
       instruction text one of them returns. Everything about documents themselves is tested
       in HexMaster.CodingStandards.Docs.Tests, against no host at all. -->

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HexMaster.CodingStandards.Mcp\HexMaster.CodingStandards.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
